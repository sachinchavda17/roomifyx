{
  "expo": {
    "name": "RoomifyX",
    "slug": "roomifyx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/roomifyx.png",
    "scheme": "roomifyx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/roomifyx.png",
        "backgroundImage": "./assets/images/roomifyx.png",
        "monochromeImage": "./assets/images/roomifyx.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sachin_chavda_dev.roomifyx"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/roomifyx.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/roomifyx.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05f609fa-061a-4446-a64a-4658c61dc350"
      }
    }
  }
}
